{
  "manifest_version":3,"name":"Splink — Atendimento e automações","version":"2.0.0","minimum_chrome_version":"111",
  "description":"Biblioteca de atendimento, campanhas persistentes, funis e fluxos para WhatsApp Web. Dados locais e estados de envio rastreáveis.",
  "permissions":["storage","scripting","alarms"],"host_permissions":["https://web.whatsapp.com/*"],
  "background":{"service_worker":"src/background.mjs","type":"module"},
  "action":{"default_title":"Abrir Splink"},"options_page":"dashboard.html",
  "icons":{"16":"assets/icon16.png","48":"assets/icon48.png","128":"assets/icon128.png"},
  "content_scripts":[
    {"matches":["https://web.whatsapp.com/*"],"js":["vendor/wa-js.js"],"world":"MAIN","run_at":"document_end"},
    {"matches":["https://web.whatsapp.com/*"],"js":["src/content.js"],"run_at":"document_idle"}
  ],
  "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'none'"}
}
